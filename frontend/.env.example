# LearnLoop Frontend Environment Configuration
# If VITE_API_BASE_URL is not set, mock fallback mode is active for standalone exploration.
# When connected to the local Flask backend (running on port 5000), you can leave this blank
# to let Vite proxy /api -> http://127.0.0.1:5000, or point explicitly to the API server:
# VITE_API_BASE_URL=http://127.0.0.1:5000
